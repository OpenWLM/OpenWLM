# ==============================================================================
# OpenWLM — Fichier d'exemple des variables d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env pour configurer votre environnement local ou de production :
#   cp .env.example .env
#
# SÉCURITÉ IMPORTANTE :
# Ne commitez JAMAIS le fichier .env réel contenant des clés ou secrets privés.
# .env et .env.* sont exclus par défaut dans le .gitignore.
# ==============================================================================

# Port d'écoute du serveur Node.js (défaut : 3001)
PORT=3001

# Environnement d'exécution (production ou development)
NODE_ENV=production

# Clé secrète JWT (optionnelle mais recommandée en production)
# Si omise, OpenWLM génère automatiquement une clé de 256 bits dans le fichier local .jwt_secret (chmod 0600).
# Longueur minimale requise si définie : 32 caractères.
JWT_SECRET=

# ==============================================================================
# Configuration Web Push (RFC 8291 / RFC 8292 VAPID)
# ==============================================================================
# Générez une paire de clés sécurisée avec la commande versionnée du projet :
#   node scripts/generate_vapid_keys.js
#
# Vous pouvez renseigner les valeurs ici ou laisser OpenWLM lire automatiquement
# le fichier local sécurisé .vapid_keys.json (chmod 0600).
# ==============================================================================

# Clé publique VAPID (P-256 base64url, ~87 caractères)
VAPID_PUBLIC_KEY=

# Clé privée VAPID (P-256 base64url, ~43 caractères)
# ATTENTION : Ne JAMAIS exposer ou commiter cette valeur !
VAPID_PRIVATE_KEY=

# Contact du responsable VAPID (doit commencer par mailto: ou https://)
VAPID_SUBJECT=mailto:admin@openwlm.dev

# ==============================================================================
# Notifications de l'app Android (Firebase Cloud Messaging), cf. docs/ANDROID.md
# ==============================================================================
# Chemin ABSOLU du fichier JSON de la clé de compte de service Firebase, rangé HORS du
# dépôt (chmod 0600). Vide : FCM désactivé, le serveur démarre normalement (Web Push seul).
# ATTENTION : ce fichier est un secret, ne JAMAIS le commiter.
FIREBASE_SERVICE_ACCOUNT=

# ==============================================================================
# Configuration WebRTC — appels audio/vidéo (STUN / TURN)
# ==============================================================================
# Servis à l'application via GET /api/rtc-config (jamais exposés côté client autrement).
#
# STUN : suffit sur les réseaux « faciles » (NAT simple). Plusieurs URLs séparées
# par des virgules. Défaut : stun:stun.l.google.com:19302
STUN_URLS=

# TURN : INDISPENSABLE pour la fiabilité (NAT symétrique, CGNAT, 4G/5G, entreprises).
# ⚠️ Un TURN N'EST PAS joignable via le Tunnel Cloudflare (HTTP uniquement) : il faut
# une IP publique avec les ports 3478/5349 (UDP/TCP) + plage de relais, OU un TURN hébergé.
# Tant que TURN_URLS et TURN_SECRET sont vides, seul STUN est renvoyé.
TURN_URLS=
# Option A — identifiants STATIQUES (ex : Metered.ca, Twilio « standard »).
# ATTENTION : Ne JAMAIS commiter ces valeurs !
TURN_USERNAME=
TURN_PASSWORD=
# Option B — identifiants ÉPHÉMÈRES via secret partagé (mécanisme « TURN REST API » / coturn) :
# username = <expiration>:<userId>, credential = HMAC-SHA1. Utilisé si USERNAME/PASSWORD absents.
# ATTENTION : Ne JAMAIS commiter cette valeur !
TURN_SECRET=
# Durée de vie des identifiants TURN, en secondes (défaut : 3600)
TURN_TTL=3600
# Politique de transport ICE : 'all' (défaut) ou 'relay' (forcer le passage par TURN)
ICE_TRANSPORT_POLICY=all

# --- Anti-inscription de masse ---
# Preuve de travail exigée à l'inscription : nombre de bits à zéro (0..24, défaut 17).
# 17 ≈ 1 à 3 s dans un navigateur récent. 0 désactive la PoW (déconseillé en production).
POW_DIFFICULTY=17
# Nombre maximal de comptes créés avec succès par IP sur 24 h glissantes (défaut 10).
SIGNUP_IP_DAILY_LIMIT=10
