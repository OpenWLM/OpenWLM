# ==============================================================================
# OpenWLM — Fichier d'exemple des variables d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env pour configurer votre environnement local ou de production :
#   cp .env.example .env
#
# SÉCURITÉ IMPORTANTE :
# Ne commitez JAMAIS le fichier .env réel contenant des clés ou secrets privés.
# .env et .env.* sont exclus par défaut dans le .gitignore.
# ==============================================================================

# Port d'écoute du serveur Node.js (défaut : 3001)
PORT=3001

# Environnement d'exécution (production ou development)
NODE_ENV=production

# Clé secrète JWT (optionnelle mais recommandée en production)
# Si omise, OpenWLM génère automatiquement une clé de 256 bits dans le fichier local .jwt_secret (chmod 0600).
# Longueur minimale requise si définie : 32 caractères.
JWT_SECRET=

# ==============================================================================
# Configuration Web Push (RFC 8291 / RFC 8292 VAPID)
# ==============================================================================
# Générez une paire de clés sécurisée avec la commande versionnée du projet :
#   node scripts/generate_vapid_keys.js
#
# Vous pouvez renseigner les valeurs ici ou laisser OpenWLM lire automatiquement
# le fichier local sécurisé .vapid_keys.json (chmod 0600).
# ==============================================================================

# Clé publique VAPID (P-256 base64url, ~87 caractères)
VAPID_PUBLIC_KEY=

# Clé privée VAPID (P-256 base64url, ~43 caractères)
# ATTENTION : Ne JAMAIS exposer ou commiter cette valeur !
VAPID_PRIVATE_KEY=

# Contact du responsable VAPID (doit commencer par mailto: ou https://)
VAPID_SUBJECT=mailto:admin@openwlm.dev
