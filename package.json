{
  "name": "openwlm",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server/index.js\"",
    "server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "ruffle:sync": "node scripts/sync_ruffle.mjs",
    "winks:prerender": "node scripts/prerender_winks.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "npm run build && concurrently \"node server/index.js\" \"wait-on http://localhost:3001 && npm run electron\"",
    "android:sync": "cap sync android",
    "android:icons": "node scripts/gen_android_icons.cjs",
    "android:apk": "cap sync android && cd android && ./gradlew assembleRelease",
    "db:seed": "node scripts/seed-demo.js",
    "check:secrets": "node scripts/check_secrets.js",
    "waf:gen": "node scripts/gen_waf_rules.mjs --write",
    "waf:check": "node scripts/gen_waf_rules.mjs --check",
    "vapid:generate": "node scripts/generate_vapid_keys.js",
    "pretest:security": "node scripts/test_preflight.js",
    "test:security": "node tests/audit_security_enforcement.js",
    "pretest:unit": "node scripts/test_preflight.js",
    "test:unit": "node --test --import ./scripts/live_server_guard.mjs tests/*.js",
    "pretest": "node scripts/test_preflight.js",
    "test": "npm run check:secrets && npm run test:security && npm run test:unit",
    "test:e2e": "npm run build && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@ruffle-rs/ruffle": "^0.7.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "upng-js": "^2.1.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
